<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the trend book's PAPER pass once an hour.

  This job PLACES NO ORDERS. research/trend/ is import-isolated from every
  order-capable module (test_trend_isolation.py) and talks to the venue only
  through the read-only client. It writes its own ledger under
  research/trend/data/ and nothing else.

  Hourly rather than at a clock time, because launchd schedules in local
  time and a sleeping Mac skips calendar jobs. The pass itself acts once per
  UTC day (on the first run after 00:00 UTC that can read everything) and
  every other run exits 0 having done nothing. Exit 1 means the venue was
  unreadable and nothing was changed; the next hour tries again.

  NOT installed by the commit that added it. Starting the run starts the
  90-day clock in research/trend/PREREG_forward.md, so it is the operator's
  act:
    cp deploy/launchd/com.cuansniffer.trendpaper.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.cuansniffer.trendpaper.plist
  Check first, without writing anything:
    the dry-run command in RUNBOOK.md, "The trend book's paper run"
  Stop:
    launchctl unload ~/Library/LaunchAgents/com.cuansniffer.trendpaper.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cuansniffer.trendpaper</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/myair/CuanSniffer/.venv/bin/python</string>
    <string>-u</string>
    <string>-m</string>
    <string>research.trend.paper</string>
    <string>--notify</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/myair/CuanSniffer</string>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>/Users/myair/Library/Logs/cuan-sniffer/trendpaper.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/myair/Library/Logs/cuan-sniffer/trendpaper.err.log</string>
</dict>
</plist>
