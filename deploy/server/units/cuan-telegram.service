[Unit]
Description=CuanSniffer telegram
After=network-online.target
Wants=network-online.target

[Service]
User=cuan
WorkingDirectory=/home/cuan/CuanSniffer
Environment=CUAN_LOG_DIR=/home/cuan/logs
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/cuan/CuanSniffer/.venv/bin/python -u -m tools.telegram_control
Restart=always
RestartSec=30
StandardOutput=append:/home/cuan/logs/telegram.log
StandardError=append:/home/cuan/logs/telegram.err.log

[Install]
WantedBy=multi-user.target
