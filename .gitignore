# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Secrets
.env
.env.*
!.env.example

# Data / logs
signals.csv
signals_*.csv
*.log
*.sqlite
*.db
*.csv
*.png
*.lock
# ...except the pins that a fresh install needs (test_static_checks.py).
!requirements.lock

# ...except the labels. 2.6KB of take/skip verdicts, and the one file here
# that nothing can regenerate: episodes and outcomes can be replayed from
# price history, but a judgement call cannot be. research/levels/ exists to
# capture judgement that lives nowhere in the codebase (see SCHEMA.md), and
# that file was being excluded by a rule written to keep 850MB of archived
# price data out of the repo.
!research/levels/data/labels.csv

# OS / editor
.DS_Store
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Build artifacts
dist/
build/
*.egg-info/

last_recap.txt
strategy_filter_state.json
oi_history_state.json
research/cascade/data/_pending_state.json

# Live trader runtime state (research/levels) -- machine-local, never shared
research/levels/data/_live_state.json
research/levels/data/_liveness.json

# Archived data from retired systems -- preserved locally, never committed.
# The CODE lives in git history (see the retirement commits); these are the
# irreplaceable DATA files, ~850MB, which cannot be regenerated.
archive/legacy_bot_data_*/
archive/cascade_data_*/
archive/funding_data_*/

# Retention archive: appended to by the daily job, so a tracked copy makes a
# live process dirty the working tree. That noise is how four uncommitted
# files sat in a deployed tree unnoticed (audit A-1). Back this up out of band.
research/levels/data/archive/

# Backtest data snapshots and trade dumps: regenerable, and the digests
# that identify them are in the committed results.
research/backtest/cache/

# Kronos weights, fetched by research/kronos/setup.sh (pinned, hash-checked)
research/kronos/hf/

# Live trader runtime state, rewritten every pass: never tracked
research/levels/data/_control_offset.json
research/levels/data/_control_queue.json
research/levels/data/_equity.json
research/levels/data/_halt.json
research/levels/data/_standdown.json
research/levels/data/_trade_meta.json
