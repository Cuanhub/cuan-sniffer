# ── Cuan Sniffer — .env.example ───────────────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env to git.

# ── RPC / Telegram ────────────────────────────────────────────────────────────
RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Tracked assets ────────────────────────────────────────────────────────────
TRACKED_WALLETS=wallet1,wallet2
TRACKED_COINS=SOL,JTO,WIF,FARTCOIN,HYPE,BTC,ETH,BNB

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=5
AGENT_POLL_INTERVAL_SECONDS=5
PERP_FEED_INTERVAL_SECONDS=60
MIN_1H_CANDLE_POLL_SECONDS=60
PERP_CACHE_TTL_SEC=10
SENTIMENT_FEED_INTERVAL_SECONDS=45

# Live data freshness / Hyperliquid backoff
LIVE_MAX_CANDLE_CACHE_AGE_SECONDS=90
LIVE_MAX_SENTIMENT_CACHE_AGE_SECONDS=900
LIVE_MAX_MARGIN_CACHE_AGE_SECONDS=60
LIVE_MAX_MIDPRICE_AGE_SECONDS=10
API_GLOBAL_BACKOFF_SECONDS=30
API_FAILURE_BURST_LIMIT=5
DATA_HEALTH_HEARTBEAT_SECONDS=60
DATA_HEALTH_STALE_SYMBOL_BLOCK_PCT=0.30
DATA_HEALTH_MIN_STALE_SYMBOLS=3
DATA_HEALTH_BREAKER_LOG_SECONDS=60

# ── Mode / balance ────────────────────────────────────────────────────────────
PAPER_MODE=true
PAUSE_NEW_SIGNALS=false
HL_TESTNET=false
STARTING_BALANCE=1000

# ── Risk ──────────────────────────────────────────────────────────────────────
RISK_PCT_PER_TRADE=1.0
MAX_OPEN_POSITIONS=3
MAX_SAME_DIRECTION=2
DAILY_LOSS_LIMIT_R=3.0
MAX_DD_PCT=15.0
MAX_SIGNAL_TO_ENTRY_ATR=4.5

# ════════════════════════════════════════════════════════════════════════════════
#  UNIFIED THRESHOLD FRAMEWORK
# ════════════════════════════════════════════════════════════════════════════════
#
#  Architecture overview:
#
#  1. CONFIDENCE (UNIVERSAL_MIN_CONFIDENCE) — THE primary quality gate.
#     Only one threshold should define "good enough." All per-gate confidence
#     variables default to UNIVERSAL_MIN_CONFIDENCE if not set.
#     Current live-test value: 0.90
#     Evidence: conf >= 0.92 in 107-trade sample → +0.317R avg, PF=1.78.
#     Set to 0.90 to allow slightly more trade flow during post-fix validation.
#
#  2. SCORE THRESHOLDS — permissive pre-filters only.
#     REGIME_SCORE_THRESHOLD_* values eliminate structural garbage before
#     the confidence gate. They are NOT quality gates. All unified at 0.64.
#     Raising these values REDUCES trade count without improving signal quality.
#
#  3. RR GATES — simplified to a single consolidated floor.
#     Old dual-gate (1.75/1.80) created 1,380 near-miss rejects, 82% within 0.10
#     of threshold. Now: MIN_STOP_REDESIGN_RR=1.60, MIN_EXECUTION_EFFECTIVE_RR=1.55.
#
#  4. 4H — re-enabled post-candle-fix (2026-06-16).
#     Historical 0/17 WR was under contaminated HTF/regime data. Architecture is
#     now correct: closed-bar resampling, no look-ahead in HTF/macro/daily zone.
#     4H still requires: confluence>=4, RR>=2.5, OB/sweep, dual HTF+macro alignment.
#
#  5. CONTINUATION — hard block removed post-candle-fix.
#     Pre-fix -19.77R was under contaminated data. Continuation still must pass:
#     confidence >= UNIVERSAL_MIN_CONFIDENCE, score pre-filter, RR gate,
#     WEAK_CONTINUATION_MIN_SCORE in weak_trend, chop/regime protections.
#
#  Startup validator: see validate_thresholds() in agent.py — prints a threshold
#  summary at boot and warns if any gate diverges from the unified framework.
# ════════════════════════════════════════════════════════════════════════════════

# Master confidence floor
UNIVERSAL_MIN_CONFIDENCE=0.90

# Per-gate overrides (all default to UNIVERSAL_MIN_CONFIDENCE if unset).
# Uncomment and override only with documented justification.
# SWING_MIN_CONFIDENCE=0.90
# SMC_4H_MIN_CONFIDENCE=0.90
# WEAK_TREND_MIN_CONFIDENCE=0.90
# CHOP_REVERSAL_MIN_CONFIDENCE=0.90
# MIN_SIGNAL_CONFIDENCE=0.90

# Score pre-filters — unified at 0.64
REGIME_SCORE_THRESHOLD_STRONG=0.64
REGIME_SCORE_THRESHOLD_WEAK=0.64
REGIME_SCORE_THRESHOLD_CHOP=0.64
MIN_SIGNAL_SCORE=0.72

# RR gates — simplified
MIN_STOP_REDESIGN_RR=1.60
MIN_EXECUTION_EFFECTIVE_RR=1.55
REGIME_TP_CAP_R=1.75
STOP_REDESIGN_RR_TOLERANCE=0.05
HIGH_CONF_STOP_REDESIGN_MIN_CONFIDENCE=0.93
HIGH_CONF_STOP_REDESIGN_RR_TOLERANCE=0.08
HIGH_CONF_STOP_REDESIGN_FAMILIES=reversal,swing

# Feature flags
SMC_ENABLE_4H_LIVE=true
HARD_BLOCK_CONTINUATION=false
HARD_BLOCK_CHOP=true
HARD_BLOCK_UNKNOWN_SESSION=true
CHOP_REVERSAL_EXCEPTION=true
CHART_PATTERN_SCORING_ENABLED=true
CHART_PATTERN_MAX_SCORE=0.10
SIGNAL_GOVERNANCE_ENABLED=true
SIGNAL_GOVERNANCE_MIN_BUCKETS=3
SIGNAL_GOVERNANCE_REQUIRE_CONTEXT=true

# ── Engine tuning ─────────────────────────────────────────────────────────────
ENGINE_ATR_STOP_MULT=1.3
ENGINE_ATR_TP_MULT=2.2
ENGINE_MIN_STOP_PCT=0.004
ENGINE_MIN_TP_PCT=0.010
ENGINE_SWING_THRESHOLD_1H=0.60
ENGINE_SWING_THRESHOLD_4H=0.65
ENGINE_DEBUG=false

# ── Stop floor / redesign ─────────────────────────────────────────────────────
STOP_ATR_FLOOR_MULT_INTRADAY=0.75
STOP_REDESIGN_MAX_WIDEN_MULT=1.50

# ── Entry validation ──────────────────────────────────────────────────────────
ENTRY_BUFFER_ATR_MULT=3.0
MAX_MOVE_STOP_FRAC=2.0
MAX_RECENT_MOVE_ATR=1.50

# ── Cooldowns ─────────────────────────────────────────────────────────────────
SIGNAL_COOLDOWN_SEC=180
REJECTED_SIGNAL_COOLDOWN_SEC=45
COIN_REENTRY_COOLDOWN_SEC=600
BUCKET_REENTRY_COOLDOWN_SEC=300

# ── Session behavior ──────────────────────────────────────────────────────────
BLOCKED_SESSIONS=dead_zone
SOFT_BLOCKED_SESSIONS=ny_pm,ny_open
SESSION_OVERRIDE_MIN_SCORE=0.84
DEAD_ZONE_OVERRIDE_MIN_SCORE=0.90
SWING_SESSION_OVERRIDE=false

# ── Bucket caps ───────────────────────────────────────────────────────────────
MAX_BUCKET_MAJORS=2
MAX_BUCKET_SOL_BETA=2
MAX_BUCKET_ALT_BETA=2
MAX_BUCKET_OTHER=0
MAX_BUCKET_MAJORS_LONG=1
MAX_BUCKET_MAJORS_SHORT=1
MAX_BUCKET_SOL_BETA_LONG=2
MAX_BUCKET_SOL_BETA_SHORT=2
MAX_BUCKET_ALT_BETA_LONG=1
MAX_BUCKET_ALT_BETA_SHORT=1

# ── Factor buckets ────────────────────────────────────────────────────────────
FACTOR_BUCKET_MAJORS_COINS=BTC,ETH,BNB
FACTOR_BUCKET_SOL_BETA_COINS=SOL,JUP,JTO,WIF,FARTCOIN,HYPE,PENGU
FACTOR_BUCKET_ALT_BETA_COINS=ARB,ZEC,TAO,NEAR,SUI

# ── Hard-blocked coins and timeframes ────────────────────────────────────────
HARD_BLOCKED_COINS=ARB,JUP,PYTH
HARD_BLOCKED_TIMEFRAMES=

