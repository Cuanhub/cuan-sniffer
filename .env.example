# ── Kill-switch ───────────────────────────────────────────────────────────────
KILL_MIN_TRADES=5
KILL_WIN_RATE=0.40
KILL_ROLLING_N=10
KILL_PAUSE_HOURS=12
COIN_MIN_TRADES=5
COIN_KILL_WIN_RATE=0.35
COIN_ROLLING_N=10
COIN_PAUSE_HOURS=12

# ── SMC structural stop ───────────────────────────────────────────────────────
SMC_OB_STOP_ENABLED=true
SMC_OB_STOP_BUFFER_ATR=0.10
SMC_OB_STOP_MIN_ATR=0.60
SMC_OB_STOP_MAX_ATR=2.50
SMC_SWING_NEAR_ZONE_ATR=0.75
SMC_SWING_MIN_CONFLUENCE_1H=3

# ── 4H swing ─────────────────────────────────────────────────────────────────
SWING_TIMEFRAMES=4h
