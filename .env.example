# Cuan Sniffer -- environment
#
# Every variable here is read by the code. The previous version of this file
# declared 121 and the code read 4 of them: the other 117 belonged to an
# earlier system (regime scoring, factor buckets, partial take-profits, an SMC
# engine) that no longer exists. Setting one of those configured nothing, which
# is worse than not offering it, so they are gone. If your own .env still has
# them they are inert -- harmless, but delete them so the file stops implying
# they do something.
#
# Nothing below needs to be set except the credentials and the arming flag.
# Every other default is in the module that reads it, next to the measurement
# or the guess it rests on; override one only when you mean to.


# ---- credentials (required) -------------------------------------------------
HL_ACCOUNT_ADDRESS=
HL_SECRET_KEY=
# Set FALSE for real money. It defaults to true so that a missing .env cannot
# accidentally trade a live account.
HL_TESTNET=false
# Only for a Hyperliquid vault; leave empty for a personal account.
HL_VAULT_ADDRESS=

# Control channel and alerts. Give this bot its OWN token from @BotFather: two
# processes polling one token steal each other's updates, and the code warns
# about it in the log and over Telegram when it sees the 409s.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ---- arming -----------------------------------------------------------------
# The trader needs BOTH this and --arm to send an order. Either one missing is
# a dry run: it prints and logs exactly what it would have done.
LEVELS_LIVE_ARMED=no


# ---- the strategy: demand bands ---------------------------------------------
# A demand zone is the base candle of an impulse that CLOSED ABOVE a prior
# swing high, running from that candle's LOW to its CLOSE. Entry is inside the
# band, the stop sits just under its low, the target is the first supply band
# overhead. See research/levels/zones.py for how each of these was measured
# against the sixteen bands the operator drew by hand.

# Bars either side for a swing pivot. Flat across 2-5; not a fragile knob.
LEVELS_ZONE_PIVOT_WINDOW=3
# How far under the band low the stop sits, as a percent.
LEVELS_ZONE_STOP_BUFFER_PCT=0.25
# Band width bounds. 0.8 is measured: thinner than this gives a stop under 1%
# away that noise takes out, and the thinnest bands carry the highest reward/
# risk, so they would dominate any ranking. His narrowest drawn band is 1.36%.
LEVELS_ZONE_MIN_WIDTH_PCT=0.8
LEVELS_ZONE_MAX_WIDTH_PCT=8.0
# How far back a band's base may sit and still be TRADEABLE. Detection keeps
# every band for ever; without this the median is 23 per coin about 1% apart,
# so price is inside one always. Age is the one feature that separated his
# bands from the rest (94th percentile of recency). 240 = 10 days of 1h.
LEVELS_ZONE_RECENT_BARS=240
# How far above a band price may sit and still be this pass's business.
LEVELS_ZONE_REACH_PCT=5.0
# History needed before any band is reported. A base can sit 700 bars back and
# below this the detector finds a thinner, more recent one instead, so short
# history returns nothing rather than a band that happens to fit in it.
LEVELS_ZONE_MIN_BARS=800

# The only gate on a plan, applied after the band and target are settled.
# Measured note: 2.0 scores worse than 1.5 against his hand verdicts (5 of 8
# against 6 of 8) and refuses two of his four takes.
LEVELS_MIN_RR=2.0


# ---- position rails ---------------------------------------------------------
# Sizing is FLAT -- this margin, levered this many times. Deriving size from
# the stop pinned risk at 3% but made the position unpredictable: a 0.9% stop
# asked for 3.3x equity, a 13% stop for 0.22x.
LEVELS_MARGIN_PCT=5.0
LEVELS_FLAT_LEVERAGE=5.0
LEVELS_MAX_LEVERAGE=10.0
LEVELS_MIN_NOTIONAL=12.0

LEVELS_MAX_CONCURRENT=4
LEVELS_MAX_NEW_PER_DAY=20
# Minutes between entries. Without it one pass fills every free slot at once.
LEVELS_ENTRY_SPACING_MINUTES=60
LEVELS_COIN_REENTRY_COOLDOWN_HOURS=6.0
# A resting entry bid is pulled after this if it never fills.
LEVELS_LIMIT_ENTRY_TTL_HOURS=12
PROTECT_BID_TTL_HOURS=12


# ---- entry vetoes -----------------------------------------------------------
# How far the live price may be from the planned entry. This is the guard a
# market fill at 8.8125 against a planned 7.50 defeated.
LEVELS_MAX_ENTRY_DRIFT_PCT=1.5
# Refuse if this hour has already traded this fraction of the way from the
# band low to the stop.
LEVELS_ENTRY_MAX_BREAK_FRAC=1.0
# Perp richness to spot, in bps. Over 248 resolved episodes perp-above-oracle
# averaged -0.524R against +0.044R at or below (p = 0.0035).
LEVELS_ENTRY_MAX_BASIS_BPS=0.0


# ---- safety ----------------------------------------------------------------
# These halt trading. SAFETY_* are the live rails in core/safety.py.
SAFETY_LIMITS_ENFORCE=true
SAFETY_DAILY_LOSS_PCT=5.0
SAFETY_DRAWDOWN_PCT=10.0
# The drawdown reference is a ROLLING window, not an all-time peak: an
# all-time peak never decays, so a drawdown measured against it grows for
# ever and the rail keeps firing against a high the account cannot reach.
SAFETY_DRAWDOWN_WINDOW_HOURS=24
# Seconds without a single successful venue read before a loop EXITS so
# launchd restarts it. A process that cannot read the venue is not doing its
# job, and some causes outlive the process: on 2026-10-19 the trader and the
# scanner lost DNS after days of uptime while `dig` resolved the host
# instantly, and nothing recovered them. Backing off cannot fix a dead
# resolver. 1200s is more than two of the trader's 450s passes, so an
# ordinary hiccup is ridden out rather than answered with a restart.
SAFETY_READ_DEAD_SEC=1200

# Seconds flatten_all will spend before giving up and alerting.
SAFETY_MAX_FLATTEN_SEC=120
SAFETY_FLATTEN_PAUSE_SEC=3

# Loss-streak stand-down, measured off closedPnl in the venue's own fills.
STREAK_TRIGGER=3
STREAK_COOLDOWN_HOURS=24
STREAK_LOOKBACK_HOURS=336


# ---- protection loop --------------------------------------------------------
# Every open position carries exactly one reduce-only stop sized to the whole
# position. This loop runs independently of the trader's signal pass.
PROTECT_POLL_SEC=60
PROTECT_MAX_RISK_PCT=3.0
PROTECT_PRICE_TOLERANCE=0.002
PROTECT_SIZE_TOLERANCE=0.01


# ---- execution --------------------------------------------------------------
# Entries and exits are marketable IOC orders crossed by this many bps. A fill
# is measured as a CHANGE IN VENUE POSITION, never parsed from the response.
EXEC_IOC_BPS=25
EXEC_EXIT_IOC_BPS=60
EXEC_SETTLE_SEC=1.5
# Seconds to wait out a venue rate limit before retrying a read.
VENUE_RATE_LIMIT_SLEEP_SEC=2.0


# ---- universe and cadence ---------------------------------------------------
LEVELS_UNIVERSE_TOP_N=45
LEVELS_UNIVERSE_EXCLUDE=KPEPE,KBONK
# Trader pass. The scanner has its own, deliberately: it is accumulating a
# record, and a record does not get better for being sampled twice as often.
LEVELS_POLL_SEC=450
LEVELS_SCANNER_POLL_SEC=900


# ---- logs and retention -----------------------------------------------------
LEVELS_LOG_ROTATE_MB=25.0
LEVELS_ERR_ROTATE_KB=64.0
LEVELS_LOG_KEEP_GENERATIONS=6
LEVELS_RETAIN_DECISION_DAYS=365
LEVELS_RETAIN_WAITING_DAYS=14
LEVELS_ERROR_RATE_ALERT=20


# ---- the scanner's logging gate --------------------------------------------
# Separate from what gets TRADED: the scanner records episodes for research,
# and research/levels/levels.py still scores levels for that record. None of
# these decide a trade. Defaults are in research/levels/config.py; they are
# listed here so it is clear they belong to the scanner, not the trader.
#   LEVELS_RUN_SIGMA_MIN  LEVELS_PULL_SIGMA_MIN  LEVELS_MIN_RETESTS
#   LEVELS_GATE_MAX_NEAR_SIGMA  LEVELS_PIVOT_WINDOW  LEVELS_HISTORY_DAYS
#   LEVELS_INTERVAL  LEVELS_CLUSTER_SIGMA  LEVELS_VOL_LOOKBACK
#   LEVELS_MIN_TOUCHES  LEVELS_MIN_TOUCHES_DETECT  LEVELS_BREAK_SIGMA
#   LEVELS_BREAK_WINDOW  LEVELS_RETEST_LOOKBACK  LEVELS_RETEST_BAND_SIGMA
#   LEVELS_TOUCH_BAND_SIGMA  LEVELS_RUN_LOOKBACK  LEVELS_RESOLVE_MIN_BARS
#   LEVELS_ONSET_MATCH_SIGMA  LEVELS_STOP_*  LEVELS_TARGET_MAX_RUNGS
#   LEVELS_ENTRY_BUFFER_SIGMA  LEVELS_RISK_PCT
